# Environment variable reference (do not commit .env)

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/crmboo"

# ── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Multi-tenant routing ────────────────────────────────────────────
# Domain for tenant subdomains, e.g. `acme.crmboo.io`
NEXT_PUBLIC_ROOT_DOMAIN=crmboo.io

# ── Vercel Domains API (optional, custom domain automation) ─────────
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
