# Environment variable reference (do not commit .env)

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/crmboo"

# ── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Multi-tenant routing ────────────────────────────────────────────
# Domain for tenant subdomains, e.g. `acme.crmboo.io`
NEXT_PUBLIC_ROOT_DOMAIN=crmboo.io

# ── Cloudflare R2 (file uploads — product images, documents) ────────
# Get these from Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=crmboo-assets
# Public URL for the R2 bucket (set up a custom domain or use the r2.dev subdomain)
R2_PUBLIC_URL=https://assets.crmboo.com

# ── Vercel Domains API (optional, custom domain automation) ─────────
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
