// CRMBoo — Production-grade multi-tenant database schema
// Stack: Prisma 5 + MySQL
// Design principles: tenant isolation, historical snapshots, audit-friendly, extensible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  CANCELLED
}

enum UserRole {
  SAAS_ADMIN
  TENANT_ADMIN
  SALES
  CUSTOMER
  ARCHITECT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  SITE
}

enum ArchitectStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RFQStatus {
  NEW
  UNDER_REVIEW
  QUOTE_READY
  FOLLOW_UP
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RFQSource {
  WEBSITE
  MANUAL
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum QuoteStatus {
  DRAFT
  SHARED
  FOLLOW_UP
  NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_SO
}

enum FollowUpMethod {
  PHONE
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  ACTIVE
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STATUS_CHANGE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DocumentType {
  RFQ
  QUOTE
  SALES_ORDER
}

// ─────────────────────────────────────────────────────────────
// SAAS PLATFORM — TENANT
// ─────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  legalName   String?
  email       String
  phone       String?
  website     String?
  gstNumber   String?      @unique
  panNumber   String?
  industry    String?
  status      TenantStatus @default(PENDING_APPROVAL)
  timezone    String       @default("Asia/Kolkata")
  currency    String       @default("INR")
  logoUrl     String?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users              User[]
  customers          Customer[]
  architects         Architect[]
  brands             Brand[]
  categories         Category[]
  products           Product[]
  rfqs               RFQ[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  followUps          FollowUp[]
  activities         Activity[]
  auditLogs          AuditLog[]
  subscriptions      Subscription[]
  tenantSettings     TenantSetting[]
  documentSequences  DocumentSequence[]
  customDomains      TenantCustomDomain[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// USERS (platform-wide — SaaS admin + all tenant roles)
// ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  rfqsCreated         RFQ[]                @relation("RFQCreatedBy")
  quotesCreated       Quote[]              @relation("QuoteCreatedBy")
  salesOrdersCreated  SalesOrder[]         @relation("SOCreatedBy")
  followUpsAssigned   FollowUp[]           @relation("FollowUpAssignedTo")
  activities          Activity[]
  auditLogs           AuditLog[]
  architectDiscounts  ArchitectDiscountHistory[]
  subscriptionEvents  SubscriptionEvent[]  @relation("SubscriptionEventPerformedBy")

  @@index([tenantId])
  @@index([tenantId, role])
}

// ─────────────────────────────────────────────────────────────
// CRM — CUSTOMER
// ─────────────────────────────────────────────────────────────

model Customer {
  id             String         @id @default(cuid())
  tenantId       String
  customerCode   String
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?
  gstNumber      String?
  panNumber      String?
  businessType   String?
  status         CustomerStatus @default(LEAD)
  notes          String?        @db.Text
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  contacts    CustomerContact[]
  addresses   CustomerAddress[]
  rfqs        RFQ[]
  quotes      Quote[]
  salesOrders SalesOrder[]
  followUps   FollowUp[]
  activities  Activity[]

  @@unique([tenantId, customerCode])
  @@index([tenantId])
  @@index([tenantId, companyName])
  @@index([tenantId, email])
  @@index([tenantId, status])
}

model CustomerContact {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  designation  String?
  email        String?
  phone        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerAddress {
  id           String      @id @default(cuid())
  customerId   String
  type         AddressType @default(BILLING)
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String      @default("India")
  gstNumber    String?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────
// CRM — ARCHITECT
// ─────────────────────────────────────────────────────────────

model Architect {
  id             String          @id @default(cuid())
  tenantId       String
  architectCode  String
  firmName       String
  contactPerson  String?
  email          String?
  phone          String?
  licenseNumber  String?
  city           String?
  state          String?
  status         ArchitectStatus @default(PROSPECT)
  currentDiscount Decimal?       @db.Decimal(5, 2)
  notes          String?         @db.Text
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  discountHistory ArchitectDiscountHistory[]
  activities      Activity[]

  @@unique([tenantId, architectCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model ArchitectDiscountHistory {
  id               String   @id @default(cuid())
  architectId      String
  previousDiscount Decimal  @db.Decimal(5, 2)
  newDiscount      Decimal  @db.Decimal(5, 2)
  reason           String?
  effectiveFrom    DateTime
  createdById      String?
  createdAt        DateTime @default(now())

  architect  Architect @relation(fields: [architectId], references: [id])
  createdBy  User?     @relation(fields: [createdById], references: [id])

  @@index([architectId])
}

// ─────────────────────────────────────────────────────────────
// PRODUCT CATALOGUE
// ─────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Product {
  id               String        @id @default(cuid())
  tenantId         String
  brandId          String?
  categoryId       String?
  sku              String
  slug             String
  name             String
  shortDescription String?
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  basePrice        Decimal?      @db.Decimal(12, 2)
  currency         String        @default("INR")
  imageUrl         String?
  isFeatured       Boolean       @default(false)
  isActive         Boolean       @default(true)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  brand          Brand?                @relation(fields: [brandId], references: [id])
  category       Category?             @relation(fields: [categoryId], references: [id])
  specifications ProductSpecification[]
  variants       ProductVariant[]
  documents      ProductDocument[]
  rfqItems       RFQItem[]
  quoteItems     QuoteItem[]
  soItems        SalesOrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
}

model ProductSpecification {
  id         String @id @default(cuid())
  productId  String
  specKey    String
  specValue  String
  unit       String?
  sortOrder  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, specKey])
  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String
  name          String
  variantCode   String?
  price         Decimal? @db.Decimal(12, 2)
  stockQuantity Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  rfqItems   RFQItem[]
  quoteItems QuoteItem[]
  soItems    SalesOrderItem[]

  @@index([productId])
}

model ProductDocument {
  id           String   @id @default(cuid())
  productId    String
  name         String
  fileUrl      String
  mimeType     String?
  fileSize     Int?
  documentType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// COMMERCE — RFQ
// ─────────────────────────────────────────────────────────────

model RFQ {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  rfqNumber      String
  status         RFQStatus @default(NEW)
  source         RFQSource @default(MANUAL)
  subject        String?
  notes          String?   @db.Text
  requestedDate  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  createdBy User?     @relation("RFQCreatedBy", fields: [createdById], references: [id])
  items     RFQItem[]
  quotes    Quote[]
  activities Activity[]

  @@unique([tenantId, rfqNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model RFQItem {
  id                   String   @id @default(cuid())
  rfqId                String
  productId            String?
  productVariantId     String?
  productNameSnapshot  String?
  skuSnapshot          String?
  description          String?
  quantity             Decimal  @db.Decimal(10, 3)
  unit                 String?
  customerNotes        String?  @db.Text
  createdAt            DateTime @default(now())

  rfq            RFQ             @relation(fields: [rfqId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([rfqId])
}

// ─────────────────────────────────────────────────────────────
// COMMERCE — QUOTE
// ─────────────────────────────────────────────────────────────

model Quote {
  id                  String      @id @default(cuid())
  tenantId            String
  rfqId               String?
  customerId          String
  quoteNumber         String
  version             Int         @default(1)
  status              QuoteStatus @default(DRAFT)
  validUntil          DateTime?
  currency            String      @default("INR")
  subtotal            Decimal     @db.Decimal(14, 2) @default(0)
  discountAmount      Decimal     @db.Decimal(14, 2) @default(0)
  taxAmount           Decimal     @db.Decimal(14, 2) @default(0)
  totalAmount         Decimal     @db.Decimal(14, 2) @default(0)
  deliveryCharges     Decimal     @db.Decimal(12, 2) @default(0)
  notes               String?     @db.Text
  termsAndConditions  String?     @db.Text
  sharedAt            DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?     @db.Text
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  rfq        RFQ?         @relation(fields: [rfqId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  createdBy  User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  items      QuoteItem[]
  followUps  FollowUp[]
  salesOrder SalesOrder?
  activities Activity[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model QuoteItem {
  id                   String  @id @default(cuid())
  quoteId              String
  productId            String?
  productVariantId     String?
  productNameSnapshot  String?
  skuSnapshot          String?
  description          String?
  quantity             Decimal @db.Decimal(10, 3)
  unit                 String?
  unitPrice            Decimal @db.Decimal(12, 2)
  discountPercent      Decimal @db.Decimal(5, 2) @default(0)
  discountAmount       Decimal @db.Decimal(12, 2) @default(0)
  taxPercent           Decimal @db.Decimal(5, 2)  @default(0)
  taxAmount            Decimal @db.Decimal(12, 2) @default(0)
  lineTotal            Decimal @db.Decimal(14, 2)

  quote          Quote           @relation(fields: [quoteId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([quoteId])
}

// ─────────────────────────────────────────────────────────────
// COMMERCE — FOLLOW-UP
// ─────────────────────────────────────────────────────────────

model FollowUp {
  id             String         @id @default(cuid())
  tenantId       String
  quoteId        String
  customerId     String
  assignedToId   String?
  method         FollowUpMethod @default(PHONE)
  subject        String?
  notes          String?        @db.Text
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  status         FollowUpStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  quote      Quote    @relation(fields: [quoteId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  assignedTo User?    @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, quoteId])
}

// ─────────────────────────────────────────────────────────────
// COMMERCE — SALES ORDER
// ─────────────────────────────────────────────────────────────

model SalesOrder {
  id                       String           @id @default(cuid())
  tenantId                 String
  customerId               String
  quoteId                  String?          @unique
  soNumber                 String
  customerPoNumber         String?
  status                   SalesOrderStatus @default(ACTIVE)
  currency                 String           @default("INR")
  subtotal                 Decimal          @db.Decimal(14, 2) @default(0)
  discountAmount           Decimal          @db.Decimal(14, 2) @default(0)
  taxAmount                Decimal          @db.Decimal(14, 2) @default(0)
  totalAmount              Decimal          @db.Decimal(14, 2) @default(0)
  deliveryCharges          Decimal          @db.Decimal(12, 2) @default(0)
  // Intentional denormalization — snapshot at time of order creation
  customerNameSnapshot     String?
  billingAddressSnapshot   String?          @db.Text
  shippingAddressSnapshot  String?          @db.Text
  notes                    String?          @db.Text
  termsAndConditions       String?          @db.Text
  orderDate                DateTime         @default(now())
  dueDate                  DateTime?
  dispatchDate             DateTime?
  deliveredAt              DateTime?
  trackingId               String?
  createdById              String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  customer  Customer         @relation(fields: [customerId], references: [id])
  quote     Quote?           @relation(fields: [quoteId], references: [id])
  createdBy User?            @relation("SOCreatedBy", fields: [createdById], references: [id])
  items     SalesOrderItem[]
  activities Activity[]

  @@unique([tenantId, soNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, orderDate])
}

model SalesOrderItem {
  id                   String  @id @default(cuid())
  salesOrderId         String
  productId            String?
  productVariantId     String?
  productNameSnapshot  String?
  skuSnapshot          String?
  description          String?
  quantity             Decimal @db.Decimal(10, 3)
  unit                 String?
  unitPrice            Decimal @db.Decimal(12, 2)
  discountPercent      Decimal @db.Decimal(5, 2) @default(0)
  discountAmount       Decimal @db.Decimal(12, 2) @default(0)
  taxPercent           Decimal @db.Decimal(5, 2)  @default(0)
  taxAmount            Decimal @db.Decimal(12, 2) @default(0)
  lineTotal            Decimal @db.Decimal(14, 2)

  salesOrder     SalesOrder      @relation(fields: [salesOrderId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([salesOrderId])
}

// ─────────────────────────────────────────────────────────────
// CRM — ACTIVITY TIMELINE
// ─────────────────────────────────────────────────────────────

model Activity {
  id           String       @id @default(cuid())
  tenantId     String
  customerId   String?
  architectId  String?
  rfqId        String?
  quoteId      String?
  salesOrderId String?
  userId       String
  type         ActivityType
  subject      String?
  description  String?      @db.Text
  createdAt    DateTime     @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  architect  Architect?  @relation(fields: [architectId], references: [id])
  rfq        RFQ?        @relation(fields: [rfqId], references: [id])
  quote      Quote?      @relation(fields: [quoteId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, rfqId])
  @@index([tenantId, quoteId])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG (append-only)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String?
  userId      String?
  entityType  String
  entityId    String
  action      AuditAction
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?     @db.Text
  createdAt   DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityType])
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────
// SAAS SUBSCRIPTION
// ─────────────────────────────────────────────────────────────

model Plan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?         @db.Text
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR")
  billingInterval BillingInterval
  trialDays       Int             @default(14)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String
  planId         String
  status         SubscriptionStatus @default(TRIAL)
  trialStartDate DateTime?
  trialEndDate   DateTime?
  startDate      DateTime?
  endDate        DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  plan   Plan                @relation(fields: [planId], references: [id])
  events SubscriptionEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model SubscriptionEvent {
  id             String  @id @default(cuid())
  subscriptionId String
  tenantId       String
  action         String
  previousStatus String?
  newStatus      String
  reason         String? @db.Text
  performedById  String?
  createdAt      DateTime @default(now())

  subscription  Subscription @relation(fields: [subscriptionId], references: [id])
  performedBy   User?        @relation("SubscriptionEventPerformedBy", fields: [performedById], references: [id])

  @@index([subscriptionId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// TENANT SETTINGS (flexible key-value)
// ─────────────────────────────────────────────────────────────

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// DOCUMENT SEQUENCE (tenant-scoped, race-condition safe)
// ─────────────────────────────────────────────────────────────

model DocumentSequence {
  id           String       @id @default(cuid())
  tenantId     String
  documentType DocumentType
  year         Int
  nextNumber   Int          @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, documentType, year])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// TENANT CUSTOM DOMAIN (for ecommerce custom domain mapping)
// ─────────────────────────────────────────────────────────────

model TenantCustomDomain {
  id         String    @id @default(cuid())
  tenantId   String
  domain     String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
